APP_NAME=AI Service
APP_VERSION=0.1.0
ENVIRONMENT=development

INTERNAL_API_KEY=replace-with-a-random-secret

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_COST_PER_MILLION_TOKENS_USD=0.02
OPENAI_PROMPT_STRATEGY=one_shot

CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=helpdesklite-knowledge-v1
CHROMA_SCHEMA_VERSION=1

RAG_CONTEXT_MAX_CHARACTERS=12000
RAG_CHUNK_SIZE_CHARACTERS=2000
RAG_CHUNK_OVERLAP_CHARACTERS=200
RAG_QUESTION_MAX_CHARACTERS=2000
